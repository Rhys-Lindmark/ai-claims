  "evidence_records": [
    {
      "evidence_id": "ggs-evidence-05a",
      "claim_id": "ggs-claim-05",
      "source_id": "ggs-source-08",
      "direction": "supports",
      "finding": "A screen of 1,313 ancient Eurasian humans detected zoonotic pathogens only from about 6,500 years ago, with a peak around 5,000 years ago that coincided with widespread livestock domestication.",
      "scope_and_limits": "Direct ancient-DNA evidence for Eurasia, but preservation, tissue choice, bloodstream abundance, and taxonomic classification affect what the screen can detect. Temporal coincidence alone does not identify one universal causal pathway."
    },
    {
      "evidence_id": "ggs-evidence-05b",
      "claim_id": "ggs-claim-05",
      "source_id": "ggs-source-09",
      "direction": "supports",
      "finding": "Eight ancient Salmonella genomes from people spanning transitional foraging, pastoralist, and agropastoralist contexts trace a branch containing human-adapted Paratyphi C and show host adaptation over roughly 5,000 years.",
      "scope_and_limits": "One bacterial lineage supports a Neolithization-linked pathway; it cannot establish the origin story of all major infectious diseases."
    },
    {
      "evidence_id": "ggs-evidence-05c",
      "claim_id": "ggs-claim-05",
      "source_id": "ggs-source-10",
      "direction": "complicates",
      "finding": "Late Neolithic plague genomes from two humans represented distinct infection events, and the study found no evidence that these cases produced a major outbreak; a contemporaneous dog offers a possible animal-contact bridge.",
      "scope_and_limits": "The result supports zoonotic exposure while cautioning against treating animal contact as sufficient for epidemic persistence or later pandemic-scale disease."
    }
  ],
