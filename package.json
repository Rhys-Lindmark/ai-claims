{
  "name": "ai-claims",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "db:generate": "drizzle-kit generate",
    "build": "vinext build",
    "test:extension": "node --test extension/test/*.test.js",
    "test:extension-release": "node scripts/check-extension-release.mjs",
    "test:analysis-requests": "node --experimental-strip-types --test lib/analysis-request-store.test.ts",
    "test:methods": "node --experimental-strip-types scripts/check-claim-selection-audit.mjs",
    "test:deployed-youtube": "node scripts/check-deployed-youtube-fixture.mjs",
    "test:deployed-goodreads": "node scripts/check-deployed-goodreads-fixture.mjs",
    "test:deployed-web": "node scripts/check-deployed-web-fixture.mjs",
    "test:deployed-compatibility": "node scripts/check-deployed-compatibility.mjs",
    "test:deployed-attestation": "node scripts/check-deployed-attestation-api.mjs",
    "test:deployed-resolver-discovery": "node scripts/check-deployed-resolver-discovery.mjs",
    "test:deployed-extension-release": "node scripts/check-deployed-extension-release.mjs",
    "package:extension": "sh scripts/package-extension.sh .",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260830.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
