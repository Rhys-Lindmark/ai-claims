{
  "manifest_version": 3,
  "name": "AI Claims — page truth layer",
  "description": "See reviewed truth scores, coverage, and sources for YouTube, Goodreads, and the web.",
  "version": "0.2.4",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "sidePanel", "storage"],
  "host_permissions": ["https://ai.rhyslindmark.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Check this page with AI Claims",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
